NODE_ENV=production
COOKIE_SECURE=true
API_BIND=0.0.0.0
API_PORT=8088
API_ORIGIN=http://api:8088
APP_ORIGINS=https://tips.example.com
GATEWAY_SECRET=REPLACE_WITH_48_RANDOM_CHARACTERS
MSSQL_PID=Express
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=TuiKhonApp;encrypt=true;trustServerCertificate=true
DB_USER=tk_runtime_v2
DB_PASSWORD=REPLACE_WITH_48_RANDOM_CHARACTERS
DB_MIGRATION_USER=tk_migrator_v2
DB_MIGRATION_PASSWORD=REPLACE_WITH_48_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_48_RANDOM_CHARACTERS
SEED_CONTENT=true
MEDIA_ROOT=/data/media
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Exact source IP of your host nginx as seen by the web container. Configure before opening VPS.
TRUSTED_PROXY=
